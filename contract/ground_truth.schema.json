{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ground_truth.schema.json",
  "title": "GroundTruthArtifact",
  "type": "object",
  "required": ["schema_version", "source_dataset", "count", "injected_rings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "source_dataset": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "injected_rings": {
      "type": "array",
      "items": { "$ref": "#/definitions/injectedRing" }
    }
  },
  "definitions": {
    "injectedRing": {
      "type": "object",
      "required": ["truth_id", "entities", "hidden_legs"],
      "additionalProperties": false,
      "properties": {
        "truth_id": { "type": "string", "pattern": "^T[0-9]+$" },
        "entities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^E[0-9]+$" },
          "minItems": 3
        },
        "hidden_legs": {
          "type": "array",
          "description": "Invoices that never reached the platform, hence never appear in invoices.json. Present ONLY here — leaking one into invoices.json removes the reason corporate-graph closure exists.",
          "items": {
            "type": "object",
            "required": ["from", "to", "value"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "pattern": "^E[0-9]+$" },
              "to": { "type": "string", "pattern": "^E[0-9]+$" },
              "value": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
