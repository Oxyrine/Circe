{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "demo/**",
      "use": "@vercel/static"
    },
    {
      "src": "console/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    },
    {
      "src": "/api/rescore",
      "dest": "/api/rescore.py"
    },
    {
      "src": "/demo/(.*)",
      "dest": "/demo/$1"
    },
    {
      "src": "/console/(.*)",
      "dest": "/console/$1"
    },
    {
      "src": "/demo",
      "dest": "/demo/index.html"
    },
    {
      "src": "/console",
      "dest": "/console/index.html"
    },
    {
      "src": "/",
      "dest": "/demo/index.html"
    }
  ]
}
